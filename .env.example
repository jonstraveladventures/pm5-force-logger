# Only needed for the optional Concept2 Logbook upload. Copy to .env and fill in.
# Register an app with Concept2 and set its redirect URI to http://localhost:8766.
CONCEPT2_CLIENT_ID=
CONCEPT2_CLIENT_SECRET=
# Written for you by `python concept2.py auth`; leave empty.
CONCEPT2_REFRESH_TOKEN=
# H (heavyweight) or L (lightweight)
CONCEPT2_WEIGHT_CLASS=H
