# Only needed for the optional Concept2 Logbook upload. Copy to .env and fill in.
# Register an app with Concept2 and set its redirect URI to http://localhost:8766.
CONCEPT2_CLIENT_ID=
CONCEPT2_CLIENT_SECRET=
# Written for you by `python concept2.py auth`; leave empty.
CONCEPT2_REFRESH_TOKEN=
# H (heavyweight) or L (lightweight)
CONCEPT2_WEIGHT_CLASS=H

# Optional: watts at a fixed heart rate and a VO2max estimate after each row (pm5_vo2.py).
# Leave empty and nothing is estimated. HRMAX: a measured maximum; or give PM5_AGE for 220 - age.
PM5_MASS_KG=
PM5_HRMAX=
PM5_HR_REST=
# The heart rate to report watts at, e.g. the top of your zone 2 (default 75% of PM5_HRMAX)
PM5_ZONE_HR=
